@model EmployeeRegisterationDto
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="pharma-card p-4 p-sm-5 animated-fade">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-person-plus text-secondary" style="font-size: 3rem;"></i>
                </div>
                <h2 class="fw-bold tracking-tight mb-1">Create Account</h2>
                <p class="text-muted small">Fill in the employee registration details</p>
            </div>

            <div asp-validation-summary="All" class="alert alert-danger p-2 small mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="EmployeeId" class="form-label d-flex align-items-center">
                            <i class="bi bi-card-text me-2 text-primary"></i> Employee ID
                        </label>
                        <input asp-for="EmployeeId" class="form-control" placeholder="E.g., EMP-101" required />
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label d-flex align-items-center">
                            <i class="bi bi-person me-2 text-primary"></i> First Name
                        </label>
                        <input asp-for="FirstName" class="form-control" placeholder="John" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label d-flex align-items-center">
                            <i class="bi bi-person me-2 text-primary"></i> Last Name
                        </label>
                        <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="BirthDate" class="form-label d-flex align-items-center">
                            <i class="bi bi-calendar-event me-2 text-primary"></i> Birth Date
                        </label>
                        <input asp-for="BirthDate" class="form-control" type="date" required />
                        <span asp-validation-for="BirthDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Sex" class="form-label d-flex align-items-center">
                            <i class="bi bi-gender-ambiguous me-2 text-primary"></i> Gender
                        </label>
                        <select asp-for="Sex" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                        </select>
                        <span asp-validation-for="Sex" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label d-flex align-items-center">
                            <i class="bi bi-telephone me-2 text-primary"></i> Phone Number
                        </label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="+123456789" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Address" class="form-label d-flex align-items-center">
                        <i class="bi bi-geo-alt me-2 text-primary"></i> Home Address
                    </label>
                    <input asp-for="Address" class="form-control" placeholder="Street, City, Country" required />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label d-flex align-items-center">
                        <i class="bi bi-envelope me-2 text-primary"></i> Email Address
                    </label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="john.doe@example.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label d-flex align-items-center">
                            <i class="bi bi-lock me-2 text-primary"></i> Password
                        </label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label d-flex align-items-center">
                            <i class="bi bi-lock-fill me-2 text-primary"></i> Confirm Password
                        </label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg px-5">
                        <i class="bi bi-person-check me-1"></i> Submit Registration
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>