@model LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="pharma-card p-4 p-sm-5 animated-fade">
            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="bi bi-capsule-pill text-primary" style="font-size: 3rem;"></i>
                </div>
                <h2 class="fw-bold tracking-tight mb-1">Sign In</h2>
                <p class="text-muted small">Access your PharmaPro account</p>
            </div>

            <div asp-validation-summary="All" class="alert alert-danger p-2 small mb-4" style="display: @(ViewData.ModelState.IsValid ? "none" : "block")"></div>

            <form asp-controller="Account" asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label d-flex align-items-center">
                        <i class="bi bi-envelope me-2 text-primary"></i> Email Address
                    </label>
                    <input asp-for="Email" class="form-control" placeholder="Enter your email" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label d-flex align-items-center">
                        <i class="bi bi-lock me-2 text-primary"></i> Password
                    </label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 mb-3">
                    <button type="submit" class="btn btn-primary btn-lg w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </div>

                <div class="text-center mt-4">
                    <span class="text-muted small">Don't have an account? </span>
                    <a asp-action="Register" asp-controller="Account" class="text-decoration-none small fw-semibold text-secondary">
                        Sign Up here
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>