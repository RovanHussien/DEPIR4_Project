@model DEPI.BLL.DTO.AdminApprovalDto
@{
    ViewData["Title"] = "Approve Employee";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h4 class="mb-0">Complete Employee Data</h4>
            </div>
            <div class="card-body">
                <form asp-action="ApproveEmployee" method="post">
                    <input type="hidden" asp-for="UserId" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BaseSalary" class="form-label">Base Salary * (Required)</label>
                            <input asp-for="BaseSalary" class="form-control" type="number" step="0.01" required />
                            <span asp-validation-for="BaseSalary" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ActualRole" class="form-label">Actual Role * (Required)</label>
                            <select asp-for="ActualRole" class="form-select" required>
                                <option value="">Select Role</option>
                                <option value="Employee">Employee</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                            <span asp-validation-for="ActualRole" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProductionLineId" class="form-label">Production Line * (Required)</label>
                        <select asp-for="ProductionLineId" class="form-select" asp-items="ViewBag.ProductionLines" required>
                            <option value="">Select Production Line</option>
                        </select>
                        <span asp-validation-for="ProductionLineId" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Approve</button>
                        <button type="submit" asp-action="RejectEmployee" asp-route-id="@Model.UserId" class="btn btn-danger" formnovalidate><i class="bi bi-x-circle me-1"></i> Reject</button>
                        <a asp-action="PendingRegistrations" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
