@model DEPI.BLL.DTO.ShiftDto
@{
    ViewData["Title"] = "Add Shift";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h4 class="mb-0">Add Shift</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateShift" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Shift Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g., Morning Shift" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label">Start Time *</label>
                            <input asp-for="StartTime" class="form-control" type="time" required />
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label">End Time *</label>
                            <input asp-for="EndTime" class="form-control" type="time" required />
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Save</button>
                        <a asp-action="Shifts" class="btn btn-secondary"><i class="bi bi-x-circle me-1"></i> Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
