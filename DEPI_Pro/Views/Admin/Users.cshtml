@model List<DEPI.BLL.DTO.UserManagementDto>
@{
    ViewData["Title"] = "User Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var groupedUsers = Model?.GroupBy(u => u.DepartmentId).ToList() ?? new List<IGrouping<int, DEPI.BLL.DTO.UserManagementDto>>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>User Management</h2>
    <a asp-action="CreateUser" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add New User</a>
</div>

@if (groupedUsers.Any())
{
    <!-- Using nav-pills to switch between departments -->
  @*   <ul class="nav nav-pills mb-4" id="departmentTabs" role="tablist">
        @for (int i = 0; i < groupedUsers.Count; i++)
        {
            var dept = groupedUsers[i];
            var deptName = dept.FirstOrDefault()?.ActualRole == "Admin" ? "System Admins" : $"Department ID: {dept.Key}";
            <li class="nav-item" role="presentation">
                <button class="nav-link @(i == 0 ? "active" : "")" id="tab-@dept.Key" data-bs-toggle="pill" data-bs-target="#content-@dept.Key" type="button" role="tab" aria-selected="@(i == 0 ? "true" : "false")">@deptName</button>
            </li>
        }
    </ul> *@

    <div class="tab-content" id="departmentTabsContent">
        @for (int i = 0; i < groupedUsers.Count; i++)
        {
            var dept = groupedUsers[i];
            <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="content-@dept.Key" role="tabpanel" tabindex="0">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Salary</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in dept)
                                    {
                                        <tr>
                                            <td>@user.FirstName @user.LastName</td>
                                            <td>@user.Email</td>
                                            <td><span class="badge bg-secondary">@user.ActualRole</span></td>
                                            <td>$@user.BaseSalary.ToString("0.00")</td>
                                            <td>
                                                @if (user.Status == DEPI.DAL.Enums.EmployeeStatus.Approved)
                                                {
                                                    <span class="badge bg-success-subtle text-success px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(25, 135, 84, 0.25);">
                                                        <i class="bi bi-check-circle-fill me-1"></i> Approved
                                                    </span>
                                                }
                                                else if (user.Status == DEPI.DAL.Enums.EmployeeStatus.Pending)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(255, 193, 7, 0.35);">
                                                        <i class="bi bi-hourglass-split me-1"></i> Pending
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger px-2 py-1" style="font-size: 0.85rem; border-radius: 6px; border: 1px solid rgba(220, 53, 69, 0.25);">
                                                        <i class="bi bi-x-circle-fill me-1"></i> Rejected
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <a asp-action="EditUser" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                                    <form asp-action="DeactivateUser" asp-route-id="@user.UserId" method="post" onsubmit="return confirm('Are you sure you want to deactivate this user?');">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No users found.</div>
}
