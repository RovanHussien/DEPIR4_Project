@model List<DEPI.BLL.DTO.ProductionLineDto>
@{
    ViewData["Title"] = "Production Lines";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Production Lines</h2>
    <a asp-action="CreateProductionLine" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Add Production Line</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Department ID</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var line in Model)
                        {
                            <tr>
                                <td>@line.Name</td>
                                <td>@line.DepartmentId</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-action="EditProductionLine" asp-route-id="@line.ProductionLineId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                        <form asp-action="DeleteProductionLine" asp-route-id="@line.ProductionLineId" method="post" onsubmit="return confirm('Are you sure you want to delete this production line?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No production lines found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
