@model DEPI.BLL.DTO.AdminDashboardStatsDto
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>System Overview</h2>
</div>

<div class="row g-4">
    <div class="col-md-4 col-lg-3">
        <div class="card bg-white h-100 shadow-sm border rounded-3 p-2">
            <div class="card-body text-start">
                <div class="mb-3">
                    <i class="bi bi-people-fill text-primary fs-4"></i>
                </div>
                <h5 class="card-title fw-bold text-dark">Total Employees</h5>
                <p class="text-muted mb-0 mt-3 d-flex align-items-center">
                    <span class="fs-2 fw-bold text-dark me-2">@Model.TotalEmployees</span>
                    <span class="small">registered<br>employees</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-3">
        <div class="card bg-white h-100 shadow-sm border rounded-3 p-2">
            <div class="card-body text-start">
                <div class="mb-3">
                    <i class="bi bi-building-fill text-success fs-4"></i>
                </div>
                <h5 class="card-title fw-bold text-dark">Departments</h5>
                <p class="text-muted mb-0 mt-3 d-flex align-items-center">
                    <span class="fs-2 fw-bold text-dark me-2">@Model.ActiveDepartments</span>
                    <span class="small">active<br>departments</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-3">
        <div class="card bg-white h-100 shadow-sm border rounded-3 p-2">
            <div class="card-body text-start">
                <div class="mb-3">
                    <i class="bi bi-hourglass-split text-warning fs-4"></i>
                </div>
                <h5 class="card-title fw-bold text-dark">Pending Approvals</h5>
                <p class="text-muted mb-0 mt-3 d-flex align-items-center">
                    <span class="fs-2 fw-bold text-dark me-2">@Model.PendingApprovals</span>
                    <span class="small">awaiting<br>review</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-3">
        <div class="card bg-white h-100 shadow-sm border rounded-3 p-2">
            <div class="card-body text-start">
                <div class="mb-3">
                    <i class="bi bi-person-badge text-info fs-4"></i>
                </div>
                <h5 class="card-title fw-bold text-dark">Active Managers</h5>
                <p class="text-muted mb-0 mt-3 d-flex align-items-center">
                    <span class="fs-2 fw-bold text-dark me-2">@Model.ActiveManagers</span>
                    <span class="small">assigned<br>managers</span>
                </p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 col-lg-3">
        <div class="card bg-white h-100 shadow-sm border rounded-3 p-2">
            <div class="card-body text-start">
                <div class="mb-3">
                    <i class="bi bi-tools text-danger fs-4"></i>
                </div>
                <h5 class="card-title fw-bold text-dark">Production Lines</h5>
                <p class="text-muted mb-0 mt-3 d-flex align-items-center">
                    <span class="fs-2 fw-bold text-dark me-2">@Model.TotalProductionLines</span>
                    <span class="small">operational<br>lines</span>
                </p>
            </div>
        </div>
    </div>
</div>
