@model List<DEPI.BLL.DTO.AttendanceRecordDto>
@{
    ViewData["Title"] = "Manager Attendance";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    DateTime? selectedDate = ViewBag.SelectedDate;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-fingerprint me-2"></i>Manager Attendance</h2>
</div>

<form method="get" asp-action="ManagerAttendance" class="row g-2 mb-4">
    <div class="col-md-3">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-calendar3"></i></span>
            <input type="date" name="date" class="form-control" value="@(selectedDate?.ToString("yyyy-MM-dd"))" />
        </div>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Filter</button>
    </div>
    <div class="col-md-2">
        <a asp-action="ManagerAttendance" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise me-1"></i>Show All</a>
    </div>
</form>

@if (Model != null && Model.Any())
{
    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle-fill text-success fs-3"></i>
                    <h4 class="mt-2 mb-0">@Model.Count(m => m.Status == "Present")</h4>
                    <small class="text-muted">Present</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-clock-fill text-warning fs-3"></i>
                    <h4 class="mt-2 mb-0">@Model.Count(m => m.Status == "Late")</h4>
                    <small class="text-muted">Late</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-x-circle-fill text-danger fs-3"></i>
                    <h4 class="mt-2 mb-0">@Model.Count(m => m.Status == "Absent")</h4>
                    <small class="text-muted">Absent</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-info shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-calendar-check text-info fs-3"></i>
                    <h4 class="mt-2 mb-0">@Model.Count(m => m.Status == "OnLeave")</h4>
                    <small class="text-muted">On Leave</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Manager Attendance Distribution</h6>
                </div>
                <div class="card-body d-flex justify-content-center align-items-center" style="height: 280px;">
                    <canvas id="mgrPieChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Weekly Manager Trend</h6>
                </div>
                <div class="card-body" style="height: 280px;">
                    <canvas id="mgrBarChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Export Buttons -->
    <div class="mb-3 d-flex gap-2">
        <button id="btnExportExcel" class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export to Excel
        </button>
        <button id="btnExportPdf" class="btn btn-danger btn-sm">
            <i class="bi bi-file-earmark-pdf me-1"></i>Export to PDF
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table id="mgrAttendanceTable" class="table table-hover table-striped mb-0" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th><i class="bi bi-person-badge me-1"></i>Manager</th>
                        <th><i class="bi bi-calendar-date me-1"></i>Date</th>
                        <th><i class="bi bi-clock me-1"></i>Shift</th>
                        <th><i class="bi bi-box-arrow-in-right me-1"></i>Check In</th>
                        <th><i class="bi bi-box-arrow-right me-1"></i>Check Out</th>
                        <th><i class="bi bi-info-circle me-1"></i>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@a.EmployeeName</td>
                            <td>@a.Date.ToString("dd/MM/yyyy")</td>
                            <td>@a.ShiftName</td>
                            <td>
                                @if (a.CheckInTime.HasValue)
                                {
                                    <span>@a.CheckInTime.Value.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (a.CheckOutTime.HasValue)
                                {
                                    <span>@a.CheckOutTime.Value.ToString("hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><span class="badge @a.StatusBadgeClass">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="alert alert-info text-center">
        <i class="bi bi-info-circle me-2"></i>
        No attendance records found for managers on the selected date.
    </div>
}

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

    <!-- DataTables CSS + JS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <!-- DataTables Export Extensions -->
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script>
        $(document).ready(function () {
            // DataTable
            var table = $('#mgrAttendanceTable').DataTable({
                pageLength: 15,
                lengthMenu: [[10, 15, 25, 50, -1], [10, 15, 25, 50, "All"]],
                order: [[1, 'desc']],
                language: {
                    search: "<i class='bi bi-search'></i> _INPUT_",
                    searchPlaceholder: "Search records...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ records",
                    paginate: {
                        first: '<i class="bi bi-chevron-double-left"></i>',
                        last: '<i class="bi bi-chevron-double-right"></i>',
                        previous: '<i class="bi bi-chevron-left"></i>'
                    }
                },
                dom: '<"row p-3 align-items-center"<"col-sm-6"l><"col-sm-6"f>>rt<"row p-3 align-items-center"<"col-sm-6"i><"col-sm-6"p>>',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        title: 'Manager Attendance Report',
                        className: 'btn btn-success btn-sm',
                        exportOptions: { columns: ':visible' }
                    },
                    {
                        extend: 'pdfHtml5',
                        title: 'Manager Attendance Report',
                        className: 'btn btn-danger btn-sm',
                        orientation: 'landscape',
                        pageSize: 'A4',
                        exportOptions: { columns: ':visible' }
                    }
                ]
            });

            $('#btnExportExcel').on('click', function () { table.button('.buttons-excel').trigger(); });
            $('#btnExportPdf').on('click', function () { table.button('.buttons-pdf').trigger(); });

            // Pie Chart
            @{
                var presentCount = Model.Count(m => m.Status == "Present");
                var lateCount = Model.Count(m => m.Status == "Late");
                var absentCount = Model.Count(m => m.Status == "Absent");
                var onLeaveCount = Model.Count(m => m.Status == "OnLeave");
            }

            var pieCtx = document.getElementById('mgrPieChart').getContext('2d');
            new Chart(pieCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Present', 'Late', 'Absent', 'On Leave'],
                    datasets: [{
                        data: [@presentCount, @lateCount, @absentCount, @onLeaveCount],
                        backgroundColor: [
                            'rgba(16, 185, 129, 0.85)',
                            'rgba(245, 158, 11, 0.85)',
                            'rgba(239, 68, 68, 0.85)',
                            'rgba(59, 130, 246, 0.85)'
                        ],
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '55%',
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { padding: 15, usePointStyle: true, font: { size: 12, family: 'Inter' } }
                        }
                    }
                }
            });

            // Bar Chart
            $.get('/api/AttendanceStats/weekly-trend?days=7&role=Manager', function (data) {
                var barCtx = document.getElementById('mgrBarChart').getContext('2d');
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: data.map(d => d.date),
                        datasets: [
                            { label: 'Present', data: data.map(d => d.present), backgroundColor: 'rgba(16, 185, 129, 0.8)', borderRadius: 4 },
                            { label: 'Late', data: data.map(d => d.late), backgroundColor: 'rgba(245, 158, 11, 0.8)', borderRadius: 4 },
                            { label: 'Absent', data: data.map(d => d.absent), backgroundColor: 'rgba(239, 68, 68, 0.8)', borderRadius: 4 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: { stacked: true, grid: { display: false } },
                            y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } }
                        },
                        plugins: {
                            legend: { position: 'top', labels: { usePointStyle: true, font: { size: 11, family: 'Inter' } } }
                        }
                    }
                });
            });
        });
    </script>
}
