@model List<DEPI.BLL.DTO.EmployeeStatusDto>
@{
    ViewData["Title"] = "Pending Registrations";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Pending Employee Registrations</h2>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee Name</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Name</td>
                                <td>@user.Email</td>
                                <td><span class="badge bg-warning text-dark">@user.Status</span></td>
                                <td>
                                    <a asp-action="ApproveEmployee" asp-route-id="@user.Id" class="btn btn-primary btn-sm">Review & Approve</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No pending registrations</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
