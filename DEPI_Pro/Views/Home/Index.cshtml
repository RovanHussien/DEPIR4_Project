@{
    ViewData["Title"] = "Home Page";
}

<div class="row justify-content-center mb-4">
    <div class="col-md-10 col-lg-9">
        <div class="pharma-card text-center p-4 p-sm-5 animated-fade">
            <div class="mb-4">
                <i class="bi bi-capsule-pill text-primary" style="font-size: 4.5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3 tracking-tight">Welcome to Pharma<span class="text-secondary">Pro</span></h1>
            <p class="lead text-muted mb-4 px-lg-5">
                Modern Pharmaceutical Factory & Employee Shift Management System.
            </p>
            
            <hr class="my-4" style="border-color: rgba(226, 232, 240, 0.8);" />

            <div class="row g-3 justify-content-center mt-2">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light text-start h-100 transition-all">
                            <h5 class="fw-bold mb-2">
                                <i class="bi bi-person-badge-fill me-2 text-primary"></i> Hello, @User.Identity.Name
                            </h5>
                            <p class="text-muted small mb-3">You are logged in. Access employee records, view factory shifts, or update statuses directly.</p>
                            <a asp-controller="Admin" asp-action="DisplayAllEmployee" class="btn btn-outline-primary w-100">
                                <i class="bi bi-people me-1"></i> Manage Employees
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light text-start h-100">
                            <h5 class="fw-bold mb-2">
                                <i class="bi bi-box-arrow-in-right me-2 text-primary"></i> Sign In
                            </h5>
                            <p class="text-muted small mb-3">Welcome back! Please login to your existing account to view and update your factory schedules.</p>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 border rounded-3 bg-light text-start h-100">
                            <h5 class="fw-bold mb-2">
                                <i class="bi bi-person-plus me-2 text-secondary"></i> Sign Up
                            </h5>
                            <p class="text-muted small mb-3">New employee? Register here to get your profile created and approved for work shifts.</p>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary w-100">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Pharmaceutical & Factory Info Cards -->
<div class="row g-4 mt-2 justify-content-center">
    <div class="col-md-6 col-lg-3">
        <div class="p-4 bg-white rounded-3 shadow-sm border h-100 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-diagram-3-fill text-primary" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold">Medicine Production</h5>
            <p class="text-muted small flex-grow-1">
                Plan and supervise the manufacturing of tablets, liquids, and vaccines. Monitor processing times and batch completions seamlessly.
            </p>
        </div>
    </div>
    
    <div class="col-md-6 col-lg-3">
        <div class="p-4 bg-white rounded-3 shadow-sm border h-100 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-shield-check text-success" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold">Quality Assurance</h5>
            <p class="text-muted small flex-grow-1">
                Validate medical standards, inspect ingredient purity, and verify that every production line conforms to FDA regulations.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="p-4 bg-white rounded-3 shadow-sm border h-100 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-box-seam text-warning" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold">Inventory Control</h5>
            <p class="text-muted small flex-grow-1">
                Track storage metrics of active raw components, medical vials, and packaged medications. Maintain full stock transparency.
            </p>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="p-4 bg-white rounded-3 shadow-sm border h-100 d-flex flex-column">
            <div class="mb-3">
                <i class="bi bi-clock-history text-danger" style="font-size: 2rem;"></i>
            </div>
            <h5 class="fw-bold">Shift & Scheduling</h5>
            <p class="text-muted small flex-grow-1">
                Effectively optimize shifts for pharmacists, laboratory technicians, and operators ensuring 24/7 continuous factory workflow.
            </p>
        </div>
    </div>
</div>
