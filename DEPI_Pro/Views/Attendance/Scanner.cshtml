@{
    ViewData["Title"] = "Fingerprint Scanner";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Fingerprint Scanner Card -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-4">
                    <i class="bi bi-fingerprint" style="font-size: 3rem;"></i>
                    <h3 class="mt-2 mb-0">Fingerprint Scanner</h3>
                    <small class="text-white-50">Place your finger on the scanner</small>
                </div>
                <div class="card-body p-4">
                    <!-- Loading State -->
                    <div id="loadingState" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="text-muted mt-2">Detecting your fingerprint...</p>
                    </div>

                    <!-- No Fingerprint State -->
                    <div id="noFingerprintState" class="text-center py-4" style="display: none;">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 2.5rem;"></i>
                        <h5 class="mt-2">No Fingerprint Registered</h5>
                        <p class="text-muted">Your account does not have a fingerprint ID assigned. Please contact your administrator.</p>
                    </div>

                    <!-- Detected Employee Info -->
                    <div id="employeeInfo" style="display: none;">
                        <!-- Auto-detected user card -->
                        <div class="d-flex align-items-center p-3 rounded-3 mb-4" style="background: linear-gradient(135deg, #f0f9ff, #e0f2fe); border: 1px solid #bae6fd;">
                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 56px; height: 56px; background: linear-gradient(135deg, #0284c7, #0d9488); color: white; font-size: 1.4rem;">
                                <i class="bi bi-person-check-fill"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold" id="employeeName"></h5>
                                <span class="badge bg-primary bg-opacity-75 mt-1" id="employeeRole"></span>
                            </div>
                            <div class="ms-auto">
                                <i class="bi bi-fingerprint text-success" style="font-size: 1.8rem;" title="Fingerprint Verified"></i>
                            </div>
                        </div>

                        <!-- Today's Status (if already checked in) -->
                        <div id="todayStatusInfo" class="alert alert-light border mb-4" style="display: none;">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-clock-history me-2 text-primary"></i>
                                <strong>Today's Record:</strong>
                            </div>
                            <div class="mt-2 d-flex gap-4">
                                <div><small class="text-muted">Check In:</small> <strong id="infoCheckIn">—</strong></div>
                                <div><small class="text-muted">Check Out:</small> <strong id="infoCheckOut">—</strong></div>
                                <div><small class="text-muted">Status:</small> <span id="infoStatus" class="badge"></span></div>
                            </div>
                        </div>

                        <!-- Hidden fingerprint ID -->
                        <input type="hidden" id="fingerprintId" />

                        <!-- Action Buttons -->
                        <div class="d-grid gap-3">
                            <button id="btnCheckIn" class="btn btn-success btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Check In
                            </button>
                            <button id="btnCheckOut" class="btn btn-danger btn-lg">
                                <i class="bi bi-box-arrow-right me-2"></i>Check Out
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Result Display -->
            <div id="resultCard" class="card shadow-sm border-0 mt-4" style="display: none;">
                <div class="card-body text-center py-4">
                    <div id="resultIcon" style="font-size: 3rem;"></div>
                    <h4 id="resultName" class="mt-2"></h4>
                    <p id="resultMessage" class="mb-1"></p>
                    <p id="resultTime" class="text-muted"></p>
                    <span id="resultStatus" class="badge fs-6"></span>
                </div>
            </div>

            @if (User.IsInRole("Manager"))
            {
                <!-- Today's Log -->
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Today's Attendance Log</h5>
                    </div>
                    <div class="card-body p-0">
                        <div id="todayLog">
                            <div class="text-center text-muted py-4">Loading...</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        loadMyFingerprint();
        @if (User.IsInRole("Manager"))
        {
            <text>loadTodayLog();</text>
        }
    });

    function loadMyFingerprint() {
        $.get('@Url.Action("GetMyFingerprint", "Attendance")', function (data) {
            $('#loadingState').hide();

            if (!data.found) {
                $('#noFingerprintState').show();
                return;
            }

            // Show detected employee info
            $('#employeeInfo').show();
            $('#employeeName').text(data.name);
            $('#employeeRole').text(data.role);
            $('#fingerprintId').val(data.fingerprintId);

            // Show today's status if already has a record
            if (data.alreadyCheckedIn) {
                $('#todayStatusInfo').show();
                $('#infoCheckIn').text(data.checkInTime ? new Date(data.checkInTime).toLocaleTimeString() : '—');
                $('#infoCheckOut').text(data.checkOutTime ? new Date(data.checkOutTime).toLocaleTimeString() : '—');

                if (data.todayStatus) {
                    var cls = data.todayStatus === 'Present' ? 'bg-success' :
                              data.todayStatus === 'Late' ? 'bg-warning text-dark' :
                              data.todayStatus === 'Absent' ? 'bg-danger' : 'bg-info';
                    $('#infoStatus').attr('class', 'badge ' + cls).text(data.todayStatus);
                }
            }

            // Disable buttons based on today's state
            if (data.alreadyCheckedIn) {
                $('#btnCheckIn').prop('disabled', true).html('<i class="bi bi-check-lg me-2"></i>Already Checked In');
            }
            if (data.alreadyCheckedOut) {
                $('#btnCheckOut').prop('disabled', true).html('<i class="bi bi-check-lg me-2"></i>Already Checked Out');
            }
            if (!data.alreadyCheckedIn) {
                $('#btnCheckOut').prop('disabled', true).addClass('btn-secondary').removeClass('btn-danger');
            }
        });
    }

    $('#btnCheckIn').on('click', function () {
        var fingerprintId = $('#fingerprintId').val();
        if (!fingerprintId) return;

        $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Scanning...');

        $.ajax({
            url: '/api/AttendanceApi/checkin',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ fingerprintId: fingerprintId }),
            success: function (result) {
                showResult(result, true);
                // Refresh state
                setTimeout(function () { loadMyFingerprint(); }, 1500);
                @if (User.IsInRole("Manager"))
                {
                    <text>loadTodayLog();</text>
                }
            },
            error: function (xhr) {
                var result = xhr.responseJSON || { success: false, message: 'An error occurred.' };
                showResult(result, false);
                $('#btnCheckIn').prop('disabled', false)
                    .html('<i class="bi bi-box-arrow-in-right me-2"></i>Check In');
            }
        });
    });

    $('#btnCheckOut').on('click', function () {
        var fingerprintId = $('#fingerprintId').val();
        if (!fingerprintId) return;

        $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Scanning...');

        $.ajax({
            url: '/api/AttendanceApi/checkout',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ fingerprintId: fingerprintId }),
            success: function (result) {
                showResult(result, true);
                // Refresh state
                setTimeout(function () { loadMyFingerprint(); }, 1500);
                @if (User.IsInRole("Manager"))
                {
                    <text>loadTodayLog();</text>
                }
            },
            error: function (xhr) {
                var result = xhr.responseJSON || { success: false, message: 'An error occurred.' };
                showResult(result, false);
                $('#btnCheckOut').prop('disabled', false)
                    .html('<i class="bi bi-box-arrow-right me-2"></i>Check Out');
            }
        });
    });

    function showResult(result, isSuccess) {
        var card = $('#resultCard');
        card.show();

        if (result.success) {
            $('#resultIcon').html('<i class="bi bi-check-circle-fill text-success"></i>');
            card.removeClass('border-danger').addClass('border-success');
        } else {
            $('#resultIcon').html('<i class="bi bi-x-circle-fill text-danger"></i>');
            card.removeClass('border-success').addClass('border-danger');
        }

        $('#resultName').text(result.employeeName || '');
        $('#resultMessage').text(result.message);
        $('#resultTime').text(result.time ? new Date(result.time).toLocaleTimeString() : '');

        if (result.status) {
            var badgeClass = result.status === 'Present' ? 'bg-success' :
                result.status === 'Late' ? 'bg-warning text-dark' :
                    result.status === 'Absent' ? 'bg-danger' : 'bg-info';
            $('#resultStatus').attr('class', 'badge fs-6 ' + badgeClass).text(result.status);
        } else {
            $('#resultStatus').text('');
        }

        // Auto-hide after 5 seconds
        setTimeout(function () { card.fadeOut(); }, 5000);
    }

    function loadTodayLog() {
        $.get('@Url.Action("TodayLog", "Attendance")', function (data) {
            var html = '';
            if (data.length === 0) {
                html = '<div class="text-center text-muted py-4">No records for today yet.</div>';
            } else {
                html = '<table class="table table-hover table-sm mb-0">';
                html += '<thead><tr><th>Employee</th><th>Check In</th><th>Check Out</th><th>Status</th></tr></thead>';
                html += '<tbody>';
                $.each(data, function (i, r) {
                    html += '<tr>';
                    html += '<td>' + r.employeeName + '</td>';
                    html += '<td>' + (r.checkInTime ? new Date(r.checkInTime).toLocaleTimeString() : '—') + '</td>';
                    html += '<td>' + (r.checkOutTime ? new Date(r.checkOutTime).toLocaleTimeString() : '—') + '</td>';
                    html += '<td><span class="badge ' + r.statusBadgeClass + '">' + r.status + '</span></td>';
                    html += '</tr>';
                });
                html += '</tbody></table>';
            }
            $('#todayLog').html(html);
        });
    }
</script>
}
