<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DEPI_Pro Admin</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DEPI_Pro.styles.css" asp-append-version="true" />
</head>
<body>
    <header style="position: relative; z-index: 1050;">
        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-light bg-white border-bottom mb-4 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Admin" asp-action="Index">
                    <i class="bi bi-shield-lock-fill me-2 text-primary" style="font-size: 1.5rem;"></i>
                    <span class="fw-bold tracking-tight text-dark">Admin<span class="text-primary">Panel</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div id="navbarContent" class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="PendingRegistrations">
                                <i class="bi bi-person-lines-fill me-1"></i> Pending
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Users">
                                <i class="bi bi-people-fill me-1"></i> Users
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="factorySetupDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-building-gear me-1"></i> Factory Setup
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="factorySetupDropdown">
                                <li><a class="dropdown-item" href="/Admin/Departments"><i class="bi bi-diagram-3 me-2"></i> Departments</a></li>
                                <li><a class="dropdown-item" href="/Admin/ProductionLines"><i class="bi bi-cpu me-2"></i> Production Lines</a></li>
                                <li><a class="dropdown-item" href="/Admin/Shifts"><i class="bi bi-clock me-2"></i> Shifts</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="ManagerAttendance">
                                <i class="bi bi-fingerprint me-1"></i> Manager Attendance
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="me-3 text-muted">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-danger border-0 p-0" style="background:none;">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container">
        <!-- Optional alerts or TempData display can go here -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3 animated-fade">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto py-3 bg-light border-top">
        <div class="container text-center text-md-start d-md-flex justify-content-between align-items-center">
            <span class="mb-2 mb-md-0 text-muted">
                &copy; 2026 - <strong class="text-dark">Staff Flow Admin Panel</strong>
            </span>
           @*  <div class="d-flex gap-3 justify-content-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary">
                    <i class="bi bi-house me-1"></i> Back to Main Site
                </a>
            </div> *@
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
