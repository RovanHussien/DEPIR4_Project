@model DEPI.BLL.DTO.ManagerDashboardDto
@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2 class="mb-1">Manager Dashboard</h2>
<p class="text-muted mb-4">Department: @Model.DepartmentName</p>

<div class="row g-3">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.EmployeesCount</h5>
                <p class="card-text">Employees</p>
                <a asp-action="Employees" class="btn btn-sm btn-primary">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.PendingLeavesCount</h5>
                <p class="card-text">Pending Leave Requests</p>
                <a asp-action="Leaves" class="btn btn-sm btn-warning">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.ShiftChangeRequestsCount</h5>
                <p class="card-text">Shift Change Requests</p>
                <a asp-action="ShiftChanges" class="btn btn-sm btn-info">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.ActiveMissionsCount</h5>
                <p class="card-text">Active Missions</p>
                <a asp-action="Missions" class="btn btn-sm btn-success">View</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.ProductionLinesCount</h5>
                <p class="card-text">Production Lines</p>
                <a asp-action="ProductionLines" class="btn btn-sm btn-secondary">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-muted"><i class="bi bi-fingerprint"></i></h5>
                <p class="card-text">Attendance</p>
                <a asp-action="Attendance" class="btn btn-sm btn-dark">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h5 class="card-title">@Model.TodaySchedulesCount</h5>
                <p class="card-text">Today's Shifts</p>
                <a asp-action="Schedules" class="btn btn-sm btn-info">Manage</a>
            </div>
        </div>
    </div>
</div>
