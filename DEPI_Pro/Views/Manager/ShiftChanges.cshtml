@model List<DEPI.BLL.DTO.ManagerShiftChangeDto>
@{
    ViewData["Title"] = "Shift Change Requests";
}

<h2>Shift Change Requests</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-arrow-left-right" style="font-size: 2rem;"></i>
        <p class="mt-2">No shift change requests found.</p>
    </div>
}
else
{
    <table class="table table-striped table-bordered mt-3">
        <thead>
            <tr>
                <th>Requesting Employee</th>
                <th>Recipient Employee</th>
                <th>Shift</th>
                <th>Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sc in Model)
            {
                <tr>
                    <td>@sc.RequestingEmployeeName</td>
                    <td>@(sc.RecipientEmployeeName ?? "-")</td>
                    <td>@(sc.ShiftName ?? "-")</td>
                    <td>@(sc.ScheduleDate?.ToShortDateString() ?? "-")</td>
                    <td>
                        @{
                            var badgeClass = sc.Status switch
                            {
                                "PendingRecipient" => "bg-warning text-dark",
                                "RecipientApproved" => "bg-info text-dark",
                                "RecipientRejected" => "bg-danger",
                                "FinalApproved" => "bg-success",
                                "FinalRejected" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                            var statusLabel = sc.Status switch
                            {
                                "PendingRecipient" => "Pending Recipient",
                                "RecipientApproved" => "Recipient Approved",
                                "RecipientRejected" => "Recipient Rejected",
                                "FinalApproved" => "Swap Executed",
                                "FinalRejected" => "Rejected",
                                _ => sc.Status
                            };
                        }
                        <span class="badge @badgeClass">@statusLabel</span>
                    </td>
                    <td>
                        @if (sc.Status == "PendingRecipient")
                        {
                            <small class="text-muted d-block mb-1">Did the recipient agree?</small>
                            <form asp-action="MarkRecipientApproved" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@sc.RequestId" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    <i class="bi bi-check-circle me-1"></i> Yes, Agreed
                                </button>
                            </form>
                            <form asp-action="MarkRecipientRejected" method="post" class="d-inline ms-1">
                                <input type="hidden" name="id" value="@sc.RequestId" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="bi bi-x-circle me-1"></i> No, Refused
                                </button>
                            </form>
                        }
                        else if (sc.Status == "RecipientApproved")
                        {
                            <small class="text-muted d-block mb-1">Recipient agreed. Confirm swap?</small>
                            <form asp-action="ApproveSwap" method="post" class="d-inline"
                                  onsubmit="return confirm('Execute the shift swap now?')">
                                <input type="hidden" name="id" value="@sc.RequestId" />
                                <button type="submit" class="btn btn-sm btn-primary">
                                    <i class="bi bi-arrow-left-right me-1"></i> Execute Swap
                                </button>
                            </form>
                            <form asp-action="RejectSwap" method="post" class="d-inline ms-1">
                                <input type="hidden" name="id" value="@sc.RequestId" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Reject</button>
                            </form>
                        }
                        else if (sc.Status == "RecipientRejected")
                        {
                            <form asp-action="RejectSwap" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@sc.RequestId" />
                                <button type="submit" class="btn btn-sm btn-secondary">
                                    <i class="bi bi-archive me-1"></i> Close
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}