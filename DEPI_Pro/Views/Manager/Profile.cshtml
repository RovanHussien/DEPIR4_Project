@model DEPI.BLL.DTO.ManagerProfileDto
@{
    ViewData["Title"] = "My Profile";
    string profileImageUrl = ViewBag.ProfileImageUrl;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">My Profile</h2>
    <a asp-action="EditProfile" class="btn btn-outline-primary">
        <i class="bi bi-pencil-square me-1"></i> Edit Profile
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="max-width: 700px;">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card shadow-sm border-0" style="max-width: 700px;">
    <div class="card-body p-4">
        <div class="d-flex align-items-center mb-4">
            <div class="rounded-circle border me-3 overflow-hidden d-flex align-items-center justify-content-center bg-light"
                 style="width: 80px; height: 80px; flex-shrink: 0;">
                @if (profileImageUrl != null)
                {
                    <img src="@profileImageUrl" alt="Profile Picture"
                         style="width: 80px; height: 80px; object-fit: cover;" />
                }
                else
                {
                    <i class="bi bi-person-fill text-primary" style="font-size: 2.2rem;"></i>
                }
            </div>
            <div>
                <h4 class="mb-1">@Model.FullName</h4>
                <span class="badge bg-primary">Manager</span>
                <span class="text-muted ms-2">@Model.DepartmentName</span>
            </div>
        </div>

        <hr />

        <div class="row gy-3">
            <div class="col-md-6">
                <small class="text-muted d-block">Employee SSN</small>
                <span class="fw-medium">@Model.EmployeeSsn</span>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Email</small>
                <span class="fw-medium">@Model.Email</span>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Phone Number</small>
                <span class="fw-medium">@Model.PhoneNumber</span>
            </div>
            <div class="col-md-6">
                <small class="text-muted d-block">Birth Date</small>
                <span class="fw-medium">@Model.BirthDate.ToShortDateString()</span>
            </div>
            <div class="col-12">
                <small class="text-muted d-block">Address</small>
                <span class="fw-medium">@Model.Address</span>
            </div>
        </div>
    </div>
</div>