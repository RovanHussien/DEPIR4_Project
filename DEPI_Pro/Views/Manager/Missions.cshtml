@model List<DEPI.BLL.DTO.ManagerMissionDto>
@{
    ViewData["Title"] = "Missions";
    var employees = ViewBag.Employees as List<DEPI.BLL.DTO.ManagerEmployeeDto>;
}

<h2>Missions</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card p-3 mb-4">
    <h5>Assign a New Mission</h5>
    <form asp-action="AssignMission" method="post" class="row g-2">
        <div class="col-md-3">
            <select name="GoesOnEmployeeSsn" class="form-select" required>
                <option value="">Select Employee</option>
                @if (employees != null)
                {
                    foreach (var emp in employees)
                    {
                        <option value="@emp.EmployeeSsn">@emp.FullName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="Purpose" class="form-control" placeholder="Purpose" required />
        </div>
        <div class="col-md-3">
            <input type="text" name="Destination" class="form-control" placeholder="Destination" />
        </div>
        <div class="col-md-1">
            <input type="date" name="StartDate" class="form-control" required />
        </div>
        <div class="col-md-1">
            <input type="date" name="EndDate" class="form-control" required />
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Assign</button>
        </div>
    </form>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Purpose</th>
            <th>Destination</th>
            <th>From</th>
            <th>To</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.EmployeeName</td>
                <td>@m.Purpose</td>
                <td>@m.Destination</td>
                <td>@m.StartDate.ToShortDateString()</td>
                <td>@m.EndDate.ToShortDateString()</td>
                <td>@m.Status</td>
            </tr>
        }
    </tbody>
</table>