@model List<DEPI.BLL.DTO.EmployeeScheduleRangeDto>
@{
    ViewData["Title"] = "Shift Schedules";
    var employees = ViewBag.Employees as List<DEPI.BLL.DTO.ManagerEmployeeDto>;
    var shifts = ViewBag.Shifts as List<DEPI.BLL.DTO.ManagerShiftDto>;
    DateTime? selectedDate = ViewBag.SelectedDate;
    string selectedDateStr = selectedDate?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Shift Schedules</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
    </a>
</div>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">@ViewBag.SuccessMessage</div>
}
@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <h5 class="mb-3">Assign Shift</h5>
        <form asp-action="AssignShift" method="post" class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Employee</label>
                <select name="EmployeeSsn" class="form-select" required>
                    <option value="">Select Employee</option>
                    @if (employees != null)
                    {
                        foreach (var emp in employees)
                        {
                            <option value="@emp.EmployeeSsn">@emp.FullName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Shift</label>
                <select name="ShiftId" class="form-select" required>
                    <option value="">Select Shift</option>
                    @if (shifts != null)
                    {
                        foreach (var shift in shifts)
                        {
                            <option value="@shift.ShiftId">
                                @shift.Name (@shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm"))
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Start Date</label>
                <input type="date" name="StartDate" class="form-control"
                       value="@selectedDateStr" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">End Date</label>
                <input type="date" name="EndDate" class="form-control"
                       value="@selectedDateStr" required />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle me-1"></i> Assign Shift
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Scheduled Shifts</h5>
            <form method="get" asp-action="Schedules" class="d-flex gap-2">
                <input type="date" name="date" class="form-control"
                       value="@selectedDate?.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-outline-primary">Filter</button>
                <a asp-action="Schedules" class="btn btn-outline-secondary">All</a>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-calendar-x" style="font-size: 2rem;"></i>
                <p class="mt-2">No shifts scheduled for the selected period.</p>
            </div>
        }
        else
        {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>From</th>
                        <th>To</th>
                        <th>Shift</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.EmployeeName</td>
                            <td>@s.StartDate.ToShortDateString()</td>
                            <td>@s.EndDate.ToShortDateString()</td>
                            <td>@s.ShiftName</td>
                            <td>@s.ShiftStart.ToString(@"hh\:mm")</td>
                            <td>@s.ShiftEnd.ToString(@"hh\:mm")</td>
                            <td>
                                <form asp-action="RemoveSchedule" method="post" class="d-inline"
                                      onsubmit="return confirm('Remove this shift range?')">
                                    <input type="hidden" name="ids" value="@string.Join(",", s.ScheduleIds)" />
                                    <input type="hidden" name="returnDate" value="@selectedDateStr" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>