@model List<DEPI.BLL.DTO.ManagerAttendanceDto>
@{
    ViewData["Title"] = "Attendance";
    DateTime? selectedDate = ViewBag.SelectedDate;
}

<h2>Attendance</h2>

<form method="get" asp-action="Attendance" class="row g-2 mb-3">
    <div class="col-md-3">
        <input type="date" name="date" class="form-control" value="@(selectedDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Employee</th>
            <th>Date</th>
            <th>Time In</th>
            <th>Time Out</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.EmployeeName</td>
                <td>@a.ScheduleDate.ToShortDateString()</td>
                <td>@a.TimeIn.ToString("hh:mm tt")</td>
                <td>@a.TimeOut.ToString("hh:mm tt")</td>
            </tr>
        }
    </tbody>
</table>